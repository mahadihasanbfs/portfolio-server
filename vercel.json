{
  "version": 2,
  "builds": [
    {
      "src": "./index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/discord/cron",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/v1/discord/cron",
      "schedule": "0 13 * * *"
    }
  ]
}